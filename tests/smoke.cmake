# Exercise startup, example validation, compact outputs and seeded VTK through the public CLI.
# All generated files stay in OUTPUT, in a fresh subdirectory on every invocation.
foreach(argument DEPOSIT EXAMPLES OUTPUT)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "Missing smoke-test argument ${argument}")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(destination "${OUTPUT}/${suffix}")
foreach(action --help --version)
    execute_process(COMMAND "${DEPOSIT}" "${action}" RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
    if(NOT status EQUAL 0 OR NOT text MATCHES "SALTED")
        message(FATAL_ERROR "Startup failed: ${status}: ${error}")
    endif()
endforeach()
foreach(shape cube stick rock)
    set(config "${EXAMPLES}/${shape}/config.conf")
    execute_process(COMMAND "${DEPOSIT}" validate --config "${config}"
        RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Validation failed for ${shape}: ${status}: ${error}")
    endif()
    execute_process(COMMAND "${DEPOSIT}" run "${config}" --output "${destination}/${shape}"
        RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Simulation failed for ${shape}: ${status}: ${error}")
    endif()
    file(READ "${destination}/${shape}/run.conf" record)
    if(NOT record MATCHES "# status \"completed\"" OR NOT record MATCHES "injection = uniform")
        message(FATAL_ERROR "Incomplete or unrecorded ${shape} run")
    endif()
    if(shape STREQUAL "cube")
        set(points 312)
        set(expected_files 2)
    elseif(shape STREQUAL "stick")
        set(points 84)
        set(expected_files 2)
    else()
        set(points 456)
        set(expected_files 3)
        file(READ "${destination}/${shape}/stl_poses.vtk" poses)
        if(NOT poses MATCHES "orientation 4 24 double")
            message(FATAL_ERROR "Rock STL poses missing")
        endif()
    endif()
    file(READ "${destination}/${shape}/deposition.vtk" vtk)
    foreach(required "DATASET POLYDATA" "POINTS ${points} double" "VERTICES ${points} " "POINT_DATA ${points}" "radius 1 ${points} double" "particle_id 1 ${points} int" "sphere_id 1 ${points} int")
        string(FIND "${vtk}" "${required}" position)
        if(position LESS 0)
            message(FATAL_ERROR "Missing VTK record in ${shape}: ${required}")
        endif()
    endforeach()
    file(GLOB outputs "${destination}/${shape}/*")
    list(LENGTH outputs count)
    if(NOT count EQUAL expected_files)
        message(FATAL_ERROR "Unexpected default output count for ${shape}")
    endif()
endforeach()
# One body exercises circle parsing, replay metadata and the unchanged redrop entry path.
file(WRITE "${destination}/circle.conf" "count = 1\ninjection = circle\nredrop = true\n")
execute_process(COMMAND "${DEPOSIT}" run "${EXAMPLES}/rock/config.conf"
    --overrides "${destination}/circle.conf" --output "${destination}/circle"
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Circular placement failed: ${status}: ${error}")
endif()
file(READ "${destination}/circle/run.conf" record)
if(NOT record MATCHES "injection = circle" OR NOT record MATCHES "# status \"completed\"")
    message(FATAL_ERROR "Circular mode was not preserved")
endif()
message(STATUS "Cube, stick, rock and circular-placement smoke checks passed; results: ${destination}")
